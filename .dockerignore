# The image needs only these two; nothing else at the root is uploaded.
*
!backend
!frontend

# Never let a local secret reach the image. Fly holds these as secrets.
**/.env
**/.env.*
!**/.env.example

**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/*.sqlite3
backend/tests
backend/evals
frontend/tests
# Local data never goes into the image.
backend/uploads
backend/uploads.before-restore-*
backend/backups
backend/export-*.zip
