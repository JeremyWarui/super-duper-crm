        "last_name": "CharField (AbstractUser)",
        "password": "CharField (AbstractUser)",
        "is_active": "BooleanField (AbstractUser)",
        "is_superuser": "BooleanField (AbstractUser)",
        "is_staff": "BooleanField (AbstractUser)",
        "date_joined": "DateTimeField (AbstractUser)",
