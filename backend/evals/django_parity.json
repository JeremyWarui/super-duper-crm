    "Supporter.registered_at": "created_at",
    "User.password": "password_hash"
  },
  "dropped": {
    "_comment": "Django name -> why it did not survive the port.",
    "User.is_staff": "drove django.contrib.admin, which no longer exists",
    "User.groups": "django.contrib.auth permission tables, replaced by User.role",
    "User.user_permissions": "django.contrib.auth permission tables, replaced by User.role",
    "User.date_joined": "renamed to created_at, from the shared TimestampMixin",
    "User.last_login": "renamed to last_login_at, for consistency with other timestamps"
  },
  "models": {
