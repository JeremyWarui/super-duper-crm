# Copy to .env and fill in. .env is gitignored; this file is not.

# Full SQLAlchemy DSN. Overrides the DB_* parts below when set.
#   Postgres:    postgresql+asyncpg://user:pass@localhost:5432/campaign_crm
#   CockroachDB: cockroachdb+asyncpg://user:pass@localhost:26257/campaign_crm
#                (needs the `cockroachdb` extra: uv sync --extra cockroachdb)
DATABASE_URL=

DB_NAME=campaign_crm
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=26257

DEBUG=true

# Minimum 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Vite dev server. JSON list.
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Log every statement. Noisy; useful when a query surprises you.
ECHO_SQL=false
