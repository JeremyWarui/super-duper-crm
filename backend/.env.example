# Copy to .env and fill in. .env is gitignored; this file is not.

# Local Postgres.
DB_NAME=campaign_crm
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# A full connection string, which overrides the DB_* values above.
# A libpq URL works as pasted, Neon's included; sslmode=verify-full checks the
# server's certificate:
# postgresql://USER:PASSWORD@HOST/campaign_db?sslmode=verify-full
DATABASE_URL=

DEBUG=true

# At least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Where the frontend runs. JSON list.
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Log every SQL statement.
ECHO_SQL=false

# Given to every account the app creates, instead of a generated password.
# Blank generates one per account, which is the only safe setting outside a demo.
DEFAULT_USER_PASSWORD=

# Which gateway carries texts to supporters' phones.
# "console" (practice) logs each text in sms_log and sends nothing, which is the
# default until there is an Africa's Talking subscription.
SMS_PROVIDER=console

# Africa's Talking. Needed only when SMS_PROVIDER=africastalking; the app
# refuses to start without them. Username "sandbox" uses their test gateway.
AT_USERNAME=
AT_API_KEY=
# A registered alphanumeric sender. Blank uses the shared short code.
AT_SENDER_ID=
AT_SANDBOX=false
# A long random string. Africa's Talking does not sign its callbacks, so this
# goes in the delivery-report, incoming-message and opt-out URLs set in its
# dashboard: <PUBLIC API URL>/api/sms/<secret>/delivery/, .../inbound/ and
# .../opt-out/. Blank turns the callbacks off.
SMS_CALLBACK_SECRET=

# Where people open the app. Invite and reset links in emails start with it.
PUBLIC_URL=http://localhost:5173

# How email goes out. "practice" sends nothing and writes each email, link
# included, to the server log (email_log keeps it with the link removed); "smtp" sends through the server below and needs SMTP_HOST and
# SMTP_FROM. Port 465 uses TLS from the start; any other port uses STARTTLS.
EMAIL_PROVIDER=practice
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# How party and campaign payments are sent. "practice" moves no money and marks
# each release paid under a PRACTICE reference; "paystack" sends M-Pesa
# transfers from the Paystack balance and needs PAYSTACK_SECRET_KEY.
PAYOUT_PROVIDER=practice
PAYSTACK_SECRET_KEY=
# The webhook signing secret (whsec_...) from Paystack > Developers > API
# configuration. Blank checks the older x-paystack-signature header instead.
# Point the Paystack webhook at https://<host>/api/payments/paystack/webhook/
PAYSTACK_WEBHOOK_SECRET=

# A built SPA to serve at "/", so the API and the app share one origin.
# Blank serves the API alone, which is how dev runs.
STATIC_DIR=

# Where uploaded logos, photos and documents are kept; back this folder up
# with the database.
UPLOAD_DIR=uploads
