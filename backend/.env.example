# Copy to .env and fill in. .env is gitignored; this file is not.

# Local Postgres.
DB_NAME=campaign_crm
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# A full connection string, which overrides the DB_* values above.
# postgresql+asyncpg://user:password@host:5432/campaign_crm
DATABASE_URL=

DEBUG=true

# At least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Where the frontend runs. JSON list.
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Log every SQL statement.
ECHO_SQL=false
