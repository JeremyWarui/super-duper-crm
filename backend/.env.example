# Copy to .env and fill in. .env is gitignored; this file is not.

# Local Postgres.
DB_NAME=campaign_crm
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# A full connection string, which overrides the DB_* values above.
# postgresql+asyncpg://user:password@host:5432/campaign_crm
# CockroachDB needs its own dialect and asyncpg's ssl=, not libpq's sslmode=:
# cockroachdb+asyncpg://user:password@host:26257/defaultdb?ssl=require
DATABASE_URL=

DEBUG=true

# At least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Where the frontend runs. JSON list.
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Log every SQL statement.
ECHO_SQL=false

# Given to every account the app creates, instead of a generated password.
# Blank generates one per account, which is the only safe setting outside a demo.
DEFAULT_USER_PASSWORD=

# Which gateway carries event invitations to supporters' phones.
# "console" records the request and sends nothing, which is the default until
# there is an Africa's Talking subscription.
SMS_PROVIDER=console

# Africa's Talking. Needed only when SMS_PROVIDER=africastalking; the app
# refuses to start without them. Username "sandbox" uses their test gateway.
AT_USERNAME=
AT_API_KEY=
# A registered alphanumeric sender. Blank uses the shared short code.
AT_SENDER_ID=
AT_SANDBOX=false

# A built SPA to serve at "/", so the API and the app share one origin.
# Blank serves the API alone, which is how dev runs.
STATIC_DIR=

# Whether POST /api/auth/register/ answers. false closes self-serve sign-up
# without a deploy, leaving the invite routes working.
ALLOW_REGISTRATION=true
