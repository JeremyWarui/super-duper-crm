#!/bin/sh
# Refuses a commit whose staged files carry a password, key or token.

for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 &&
    "$py" -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
    exec "$py" tools/secret-scan/scan.py --staged
  fi
done

echo "pre-commit: Python 3.10+ is needed to run tools/secret-scan/scan.py" >&2
exit 1
