# Settings for deploy/docker-compose.yml. Copy to .env in this folder and fill in the
# required lines; everything else may stay as it is. Never commit .env.
# A value with a $ in it (a password, say) goes in single quotes, so the $ is kept.
# Every setting the app reads is listed here (backend/src/backend/config.py).

# ---------------------------------------------------------------- required
# The web address people open, without https:// (for example crm.example.org).
DOMAIN=
# Where the certificate authority writes about certificates for DOMAIN.
ACME_EMAIL=
# Set by docker-compose.yml to https:// and DOMAIN; links in emails start with it.
PUBLIC_URL=
# A long random string, at least 32 characters; keep it secret.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# The database password; make one the same way.
DB_PASSWORD=

# ---------------------------------------------------------------- database
DB_NAME=campaign_crm
DB_USER=campaign_crm
# DB_HOST and DB_PORT are set by docker-compose.yml.
DB_HOST=db
DB_PORT=5432
# A full connection string instead of the DB_* parts; leave blank here.
DATABASE_URL=
# Log every SQL statement (troubleshooting only).
ECHO_SQL=false

# ---------------------------------------------------------------- the app
DEBUG=false
# The site and API share one address, so no other origin may call the API.
CORS_ALLOW_ORIGINS=[]
# Paths inside the containers; leave them as they are.
STATIC_DIR=/app/static
UPLOAD_DIR=/app/uploads
BACKUP_DIR=/backups
# Where pg_dump and pg_restore are; blank finds them in the image.
PG_BIN_DIR=
# The hour (UTC) of the nightly backup; 0 is 03:00 in Kenya.
BACKUP_HOUR_UTC=0
# Seconds between runs applying public party requests; 0 turns it off.
PARTY_INBOX_SECONDS=60
# Hours between comparisons of the payments ledger with the payout provider; 0 turns it off.
RECONCILE_HOURS=24
# Blank gives every new login its own generated password (invites set their own).
DEFAULT_USER_PASSWORD=

# ---------------------------------------------------------------- email
# "practice" sends nothing and writes every email, link included, to the app's log
# (docker compose logs app).
EMAIL_PROVIDER=practice
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# For example: Party Name <noreply@example.org>
SMTP_FROM=

# ---------------------------------------------------------------- SMS (Africa's Talking)
# "console" keeps every text in the SMS log and sends nothing; "africastalking" sends.
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
# Blank uses the shared short code.
AT_SENDER_ID=
AT_SANDBOX=false
# The secret part of the delivery-report and inbound-text URLs given to Africa's Talking;
# blank turns those callbacks off.
SMS_CALLBACK_SECRET=

# ---------------------------------------------------------------- payouts (Paystack)
# "practice" moves no money; "paystack" sends M-Pesa transfers.
PAYOUT_PROVIDER=practice
PAYSTACK_SECRET_KEY=
# The webhook signing secret (whsec_...) from the Paystack dashboard.
PAYSTACK_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Google sign-in
# Both blank hides the button. The OAuth client's redirect URI is
# PUBLIC_URL followed by /api/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
